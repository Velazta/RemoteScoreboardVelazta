# Supabase Configuration
# Dapatkan Project URL dan Anon Key di: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Opsional / Service Role Key (Hanya untuk server backend/seed, jangan pernah diberi prefix NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
